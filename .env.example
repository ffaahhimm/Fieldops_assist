# ─── FieldOps Assist — Environment Variables Template ────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/fieldops.db
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# ── AI / RAG ─────────────────────────────────────────────────────────────────
# Leave blank to run in retrieval-only / no-LLM mode.
# Supported providers: openai | anthropic | none
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Embedding model used for document indexing (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Dev seed ─────────────────────────────────────────────────────────────────
SEED_DEMO_DATA=true
